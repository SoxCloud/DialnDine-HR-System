# ============================================================
# Dial n Dine HR System — server-side Google Sheets credentials
# ============================================================
# Copy this file to .env.local and fill in the real values.
#
# SECURITY:
#  - These are SERVER-ONLY secrets. Never add a NEXT_PUBLIC_ prefix
#    (that would bundle them into the browser).
#  - Create the service account in Google Cloud, enable the
#    Google Sheets API, and share the target spreadsheet with the
#    service account email (view/edit).
# ============================================================

GOOGLE_SHEET_ID=your_sheet_id_here

GOOGLE_CLIENT_EMAIL=your_service_account_email

# Keep the whole key on ONE line, with literal \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...replace-with-your-key...\n-----END PRIVATE KEY-----\n"